{
  // Type-checks everything (app, tests, mock API, scripts). Every .ts file here can also be run
  // directly by Node >= 22.18 (type stripping), which is how tests and dev tools run.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    // Keep the source runnable by Node's type stripping: imports use .ts extensions, no
    // enums/namespaces/parameter properties, and type-only imports are marked as such.
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true
  },
  "include": ["src", "tests", "mock-api", "scripts"]
}
