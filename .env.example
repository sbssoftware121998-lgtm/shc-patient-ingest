# Copy to .env for local runs. `npm run ingest` / `npm start` and `npm run mock-api` read it.
# Never commit .env.

# --- Ingestion script: point it at the local mock API ---
SHC_API_URL=http://localhost:8080/v1/patients
SHC_ALLOW_INSECURE_HTTP=true
SHC_API_TOKEN=local-demo-token
# The input is always data/input/patients.csv (copy the export there); it is not configurable.
SHC_OUTPUT_DIR=output
# SHC_DRY_RUN=true
# SHC_LOG_LEVEL=debug
# SHC_LOG_FORMAT=pretty   # auto (default): readable at a terminal, JSON lines when piped

# --- Mock SHC API ---
MOCK_API_TOKEN=local-demo-token
# Where `npm run mock-api` stores patients: your local PostgreSQL (e.g. Postgres.app).
# The database and the table are created if missing. Docker uses its own PostgreSQL instead.
DATABASE_URL=postgres://<your-mac-username>@localhost:5432/shc_demo
# MOCK_STORAGE=memory   # no database: keep patients in memory only
# MOCK_DB_TABLE=global_health_client_patient_data_master
