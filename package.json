{
  "name": "shc-patient-ingest",
  "version": "1.0.0",
  "private": true,
  "description": "Extracts, cleans and loads GlobalHealth Corp legacy patient data into the SHC Platform API",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prestart": "npm run build",
    "start": "node --env-file-if-exists=.env --enable-source-maps dist/index.js",
    "success": "node --env-file-if-exists=.env src/index.ts success",
    "validation": "node --env-file-if-exists=.env src/index.ts validation",
    "failed": "node --env-file-if-exists=.env src/index.ts failed",
    "docker:up": "docker compose up -d --wait --build postgres mock-api",
    "docker:success": "docker compose run --rm --build ingest success",
    "docker:validation": "docker compose run --rm --build ingest validation",
    "docker:failed": "docker compose run --rm --build ingest failed",
    "docker:down": "docker compose down",
    "ingest": "node --env-file-if-exists=.env src/index.ts",
    "dev": "node --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --env-file-if-exists=.env scripts/test-and-load.ts",
    "test:unit": "node --test \"tests/**/*.test.ts\"",
    "mock-api": "node --env-file-if-exists=.env mock-api/server.ts"
  },
  "dependencies": {
    "csv-parse": "7.0.3"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "pg": "8.23.1",
    "typescript": "6.0.3"
  }
}
